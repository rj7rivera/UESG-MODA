# Número de WhatsApp de UESG para recibir pedidos.
# Formato E.164 SIN "+", espacios ni guiones (solo dígitos, con código de país).
# Ejemplo Ecuador: el número local 0969580879 se escribe como 593969580879
VITE_UESG_WHATSAPP_NUMBER=593969580879

# URL pública canónica, sin slash final. Se usa en canonical, Open Graph,
# JSON-LD, robots.txt y sitemap.xml.
VITE_UESG_SITE_URL=https://www.ejemplo.com
